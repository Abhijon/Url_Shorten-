    "prisma:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "prisma:seed": "tsx prisma/seed.ts",
    "start:docker": "prisma migrate deploy && node dist/server.js"
  },
  "keywords": [
    "url-shortener",
    "express",
    "prisma"
  ],
  "author": "",
