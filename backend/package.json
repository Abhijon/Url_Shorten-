{
  "name": "url-shortener-backend",
  "version": "1.0.0",
  "description": "Production-ready URL Shortener API",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "prisma:generate": "prisma generate",
