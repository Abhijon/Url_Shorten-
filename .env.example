# =============================================================================
# Docker Compose environment (copy to .env — never commit .env)
# All runtime/build config for containers comes from here.
# =============================================================================

# Postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=url_shortener
POSTGRES_PORT=5433

# Redis
REDIS_PORT=6379

# App ports (host → container)
BACKEND_PORT=3000
FRONTEND_PORT=5173

# Backend runtime (service hostnames: postgres, redis)
NODE_ENV=production
PORT=3000
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/url_shortener?schema=public
REDIS_URL=redis://redis:6379
BASE_URL=http://localhost:3000

# Frontend build (browser calls the host-mapped API)
VITE_API_BASE_URL=http://localhost:3000
